# auto-claude configuration
# Copy this file to config.toml and edit to match your environment:
#   cp config.toml.sample config.toml

[github]
org = "your-org"
# Only list a repo once its .claude/pipeline.json declares real verify/test
# commands. A repo without them still passes review — the check runner reports
# "no verify/test commands configured" and returns ok — so the approval has no
# build gate behind it. Listing a repo here also stamps the ac-* label set on
# it at startup, so an unconfigured repo is not a free addition.
repos = [
    "repo-one",
    "repo-two",
]
poll_interval_seconds = 60
base_branch = "main"        # branch to branch from and PR into
label_prefix = "ac-"
# GitHub account auto-claude acts as. Startup preflight fails if the configured
# token authenticates as anyone else. Omit to disable the identity check.
bot_login = "accelevation-bot"
needs_info_label = "ac-needs-info"
pr_created_label = "ac-pr-created"
in_progress_label = "ac-in-progress"
action_labels = ["ac-fix", "ac-implement", "ac-test", "ac-rework"]
dev_actions = ["fix", "implement", "test", "rework"]
rework_label = "ac-rework"

[claude]
triage_model = "claude-haiku-4-5"
dev_model = "claude-sonnet-5"          # default model for dev actions
light_model = "claude-haiku-4-5"         # used for handoff summaries
permission_mode = "bypassPermissions"
max_budget_usd = 10.0
output_format = "stream-json"
grace_budget_usd = 1.0                   # extra budget for handoff summary when main budget is exceeded
max_turns_dev = 50                       # max tool-use turns for dev workers

# Per-action model overrides (optional). Actions not listed use dev_model.
[claude.action_models]
implement = "claude-opus-5"            # complex features get Opus
fix = "claude-sonnet-5"
test = "claude-sonnet-5"
rework = "claude-sonnet-5"

[workers]
max_parallel = 3
max_continuations = 2            # max continuation runs after budget exhaustion (3 total)
shutdown_grace_seconds = 30

# Every path key in this file - here, [integrations], and each [repos.*]
# env_source - supports `${VAR}` and `~` expansion. Values come from the
# environment, including the gitignored .env, which is loaded before this file.
#
# Relative paths resolve against the directory holding config.toml, so a value
# like "../accelevation/field_admin" silently repoints if you move the harness.
# Name the location instead and moving becomes a one-line env change:
#
#   env_source = "${ACCELEVATION_ROOT}/field_admin"
#
# An undefined variable is a startup error, not a directory literally named
# "${VAR}".
[paths]
repos_dir = "repos"
worktrees_dir = "worktrees"
state_file = "state/issues.json"
log_file = "logs/auto-claude.log"
prompts_dir = "prompts"
crash_logs_dir = "crash_logs"

[logging]
level = "INFO"       # DEBUG | INFO | WARN | ERROR
colorize = true
log_to_file = true

# Optional. Points at a checkout of accelevation-claude-tools, whose Node
# scripts back shared telemetry and Projects v2 board sync. Omit this section
# (or leave claude_tools_root unset) to disable both - it is safe to run
# without it.
[integrations]
claude_tools_root = "../accelevation-claude-tools"

# Optional. Shares issue state, lease and run history across harnesses via the
# `auto_claude` schema on PIPELINE_METRICS_DATABASE_URL (see docs/plans/
# 12-shared-state-in-postgres.md). Omit this section entirely to use every
# default below. State stays purely local — degraded, not dead — whenever the
# url_env variable is unset, regardless of `enabled`.
[database]
enabled = true
url_env = "PIPELINE_METRICS_DATABASE_URL"
lease_ttl_seconds = 1800
heartbeat_interval_seconds = 60
journal_file = "state/journal.jsonl"
connect_timeout_seconds = 10
