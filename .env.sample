# auto-claude secrets. Copy to `.env` (gitignored) and fill in.
#
#   cp .env.sample .env
#
# Values here are loaded into the process environment at startup and inherited
# by worker processes and every subprocess they spawn. An environment variable
# that is already set always wins, so you can override any single value without
# editing this file.

# Postgres connection string for the shared pipeline-metrics database, the same
# one accelevation-claude-tools writes to. auto-claude passes this straight to
# log-event.mjs, so the sibling checkout needs no .env of its own.
#
# Without it, telemetry is dropped - safely and loudly (startup warns), but
# dropped. Nothing else breaks.
PIPELINE_METRICS_DATABASE_URL=postgresql://user:password@host:5432/dbname

# The bot's GitHub PAT can live here instead of `.gh_token` if you prefer one
# file. Either works; `.gh_token` takes precedence only if this is unset.
# AUTO_CLAUDE_GH_TOKEN=github_pat_...
